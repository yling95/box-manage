{
  "name": "vite-vue-ts-base",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev1": "vite --mode development1 --port 10000",
    "dev2": "vite --mode development2 --port 10001",
    "staging": "vite build --mode staging",
    "build": "vite build",
    "build-for-prod": "vite build --mode ci",
    "preview": "vite preview",
    "ts": "vue-tsc --noEmit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue .",
    "lint:fix": "eslint .js,.jsx,.ts,.tsx,.vue . --fix",
    "prettier": "prettier --write .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.7.0",
    "@vueuse/core": "^10.3.0",
    "ant-design-vue": "^3.2.20",
    "axios": "1.5.0",
    "dayjs": "^1.11.7",
    "echarts": "^5.4.2",
    "fabric": "^5.3.0",
    "g6-fn": "^1.0.28",
    "g6-ui": "^1.0.9",
    "lazysizes": "^5.3.2",
    "perfect-scrollbar": "^1.5.5",
    "pinia": "^2.0.35",
    "pinia-plugin-persistedstate": "^3.1.0",
    "sm-crypto": "^0.3.12",
    "v3-infinite-loading": "^1.3.1",
    "vite-svg-loader": "^5.1.0",
    "vue": "3.3.4",
    "vue-countup-v3": "^1.3.0",
    "vue-request": "^2.0.0-rc.4",
    "vue-router": "^4.1.6",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.3",
    "@commitlint/config-conventional": "^17.6.3",
    "@types/fabric": "^5.3.2",
    "@types/sm-crypto": "^0.3.0",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "@vitejs/plugin-vue": "^4.1.0",
    "@vitejs/plugin-vue-jsx": "^3.0.1",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.11.0",
    "husky": "^8.0.3",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "lint-staged": "^13.2.2",
    "postcss-preset-env": "^9.0.0",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^5.9.2",
    "typescript": "^5.0.2",
    "unplugin-vue-components": "^0.24.1",
    "vite": "^4.3.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imp": "^2.4.0",
    "vue-tsc": "^1.4.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx}": [
      "prettier --write .",
      "git add ."
    ]
  }
}
